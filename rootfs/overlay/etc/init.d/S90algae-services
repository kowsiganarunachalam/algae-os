#!/bin/sh

DAEMON="/usr/bin/algae-service-manager"
PIDFILE="/run/algae-service-manager.pid"
LOGFILE="/var/log/algae-service-manager.log"

case "$1" in
    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "Algae Service Manager is already running"
            exit 0
        fi

        echo "Starting Algae Service Manager..."

        "$DAEMON" >> "$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"

        echo "Algae Service Manager started"
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            pid="$(cat "$PIDFILE")"
            kill "$pid" 2>/dev/null
            count=0
            while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 50 ]; do
                sleep 0.1
                count=$((count + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null
            fi
            rm -f "$PIDFILE"
            echo "Algae Service Manager stopped"
        fi
        ;;

    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
